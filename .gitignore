*.pem
*.key
*.id_rsa
*.id_ed25519
*.id_ecdsa
id_rsa*
id_ed25519*
honeypot-key.pem
*.cer
*.crt
*.pfx
*.p12

# Arquivos de Variáveis de Ambiente e Credenciais
.env
.env.*
*.env
*credentials*
*secret*
*token*

# Credenciais e Variáveis Locais do Terraform (contêm IPs pessoais)
*.tfvars
!*.tfvars.example
terraform.tfvars

# Estado Local do Terraform
*.tfstate
*.tfstate.*
*.tfplan
crash.log
crash.*.log
.terraform/
.terraform.lock.hcl

# Python / Ambientes Virtuais
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
env/
venv/
.venv/

# Logs temporários e gravações TTY binárias
*.log
logs_salvos/
logs_salvos/tty/

